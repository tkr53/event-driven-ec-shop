    {
      "id": 50,
      "type": "row",
      "title": "Logs",
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 51,
      "type": "logs",
      "title": "API Logs",
      "gridPos": { "x": 0, "y": 41, "w": 12, "h": 10 },
      "datasource": { "type": "loki", "uid": "" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "" },
          "expr": "{service_name=\"ec-api\"} | json",
          "refId": "A"
        }
      ]
    },
    {
      "id": 52,
      "type": "logs",
      "title": "Error Logs (All Services)",
      "gridPos": { "x": 12, "y": 41, "w": 12, "h": 10 },
      "datasource": { "type": "loki", "uid": "" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
